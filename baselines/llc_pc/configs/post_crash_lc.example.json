{
  "data": {
    "train_mat": "<PATH_TO_TRAIN_MAT>",
    "validation_mat": "<PATH_TO_VALIDATION_MAT>",
    "test_mat": "<PATH_TO_TEST_MAT>",
    "train_key": "train_data",
    "validation_key": "validation_data",
    "test_key": "test_data",
    "history_steps": 10,
    "future_steps": 50,
    "sample_rate_hz": 10.0,
    "neighbor_roles": [
      "phys_tl",
      "phys_tf",
      "phys_tff",
      "phys_ol",
      "phys_of",
      "phys_off"
    ]
  },
  "paths": {
    "work_dir": "outputs/llc_pc",
    "raw_context_dir": "outputs/llc_pc/raw_contexts",
    "encoded_context_dir": "outputs/llc_pc/encoded_contexts",
    "context_index": "outputs/llc_pc/context_index/train_context_index.npz",
    "intention_points": "outputs/llc_pc/intention_points/intention_points.npz",
    "checkpoint_dir": "outputs/llc_pc/checkpoints"
  },
  "llm": {
    "model": "qwen3-vl-plus",
    "base_url_env": "LLM_BASE_URL",
    "api_key_env": "LLM_API_KEY",
    "temperature": 0.7,
    "max_tokens": 1200,
    "seed": 42
  },
  "context": {
    "dimension": 17,
    "k": 4,
    "metric": "euclidean",
    "exclude_same_event": true
  },
  "intention_points": {
    "n_clusters": 64,
    "random_state": 42,
    "max_iter": 100
  },
  "model": {
    "d_model": 256,
    "nhead": 8,
    "encoder_layers": 3,
    "decoder_layers": 3,
    "dropout": 0.1,
    "num_queries": 64,
    "num_output_modes": 6
  },
  "train": {
    "batch_size": 64,
    "epochs": 100,
    "learning_rate": 0.0001,
    "seed": 42,
    "num_workers": 0,
    "device": "auto"
  },
  "evaluation": {
    "prediction_mode": "top1",
    "horizons_seconds": [1, 2, 3, 4, 5]
  }
}
